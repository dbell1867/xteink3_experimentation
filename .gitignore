# PlatformIO build output (regenerated by `pio run`)
.pio/
# Editor/compile helpers
.vscode/
compile_commands.json
# Factory flash dump: 16 MB, contains the stock firmware and its NVS settings.
# Keep it locally (+ a private off-site copy); restore steps stay in backup/README.md.
backup/*.bin

# Rendered pages (regenerate with tools/mdpages.py)
build/

# Python environment for tools/ (python -m venv .venv && .venv/bin/pip install -r tools/requirements.txt)
.venv/
__pycache__/
*.egg-info/
